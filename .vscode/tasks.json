{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: build",
      "type": "cmake",
      "command": "build",
      "targets": [
        "StationBuilder"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "CMake: build README screenshots",
      "type": "cmake",
      "command": "build",
      "targets": [
        "ReadmeShots"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "CMake: build the 2D lighting prototype",
      "type": "cmake",
      "command": "build",
      "targets": [
        "Lighting2DDemo"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Build the 3D prototype (raylib)",
      "type": "shell",
      "command": "${workspaceFolder}/prototypes/raylib3d/build.bat",
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
